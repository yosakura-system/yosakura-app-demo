/** ============================================================
 * チェックリスト登録_鰻富士山.gs — 鰻富士山店の紙の開店チェックリストをアプリへ登録する1回きりの関数
 * （2026-09-10 長田さん「紙よりアプリで完結できた方が嬉しい。ぜひ導入を」への対応）
 *
 * ■ 使い方
 *   ① このファイルを「世桜アプリバックエンド」プロジェクトに追加
 *   ② 関数 鰻富士山_開店チェックリストを登録 を実行
 *   → 店舗のオープンチェックリストに16項目が並ぶ（誰がチェックしたかも記録される）
 *
 * ■ 直したいとき
 *   アプリ上で店長・オーナー・本部が「×で外す」「追加」で自由に直せる（このGASの再実行は不要）
 *   ★もう一度この関数を実行すると、アプリ上で直した内容がこの16項目で上書きされるので再実行しない
 * ============================================================ */

function 鰻富士山_開店チェックリストを登録() {
  var STORE = '日本鰻世桜 富士山店';
  var LABELS = [
    '暖簾・A看板・オープン看板・お待ちボードを設置する',
    '切り場：まな板と包丁を設置する',
    'おしぼりを所定の数出しておく',
    'カウンターを拭く',
    'スチコンを予熱し、すぐ焼ける状態にする',
    '保温ジャーを準備する',
    'スープジャーを準備する',
    'ポットを98℃に設定する',
    '決済端末を充電する',
    'iPhoneを充電する',
    'スピーカー：BGMが流れているか確認する',
    'おしぼりとアルコールを補充する',
    'レジ金3万円があるか確認する',
    '予約が正常に案内できるか確認する',
    'エアコン：ホール・キッチン2箇所ON、左右上下スイングに設定する',
    '全ての照明をON'
  ];
  var base = Date.now().toString(36);
  var items = LABELS.map(function (l, i) { return { id: 'open-x-' + base + i.toString(36), label: l }; });
  var sh = getSheet();
  sh.appendRow([Utilities.getUuid(), Date.now(), 'ckitem', STORE, '', '',
    JSON.stringify({ mode: 'open', items: items }), '[]']);
  Logger.log('登録しました：' + STORE + ' のオープンチェックリストに ' + items.length + ' 項目。');
  Logger.log('アプリ側は次の同期（開き直し）で反映されます。');
}
